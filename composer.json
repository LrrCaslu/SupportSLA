{
  "name": "support-sla/support-sla",
  "description": "Sistema de Help Desk com gerenciamento de SLA para ServBay.",
  "type": "project",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "SupportSla\\": "app/"
    }
  },
  "scripts": {
    "install-local": "php scripts/install.php",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}

